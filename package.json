{
  "name": "elo-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de vendas com atendimento omnichannel (chatbot + URA) - CRUD completo em Node.js + PostgreSQL",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:usuarios": "tsx src/db/seed-usuarios.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && npm run db:seed && npm run db:usuarios && npm run db:bot",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "legado:start": "node src/server.js",
    "db:bot": "tsx src/db/seed-bot.ts",
    "db:senha": "tsx src/db/redefinir-senha.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "next": "^16.3.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
