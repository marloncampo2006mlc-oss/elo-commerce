{
  "name": "elo-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de vendas com atendimento omnichannel (chatbot + URA) - CRUD completo em Node.js + PostgreSQL",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "setup": "npm run db:reset && npm start",
    "test": "node --test tests/"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
