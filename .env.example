# Servidor
PORT=3333
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=elo_commerce

# Sessão administrativa
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
ADMIN_PASSWORD=defina-uma-senha-forte

# Pix — sem estas variáveis, o checkout gera um código de DEMONSTRAÇÃO
# (formato válido, chave de exemplo, nenhum valor transferido).
# PIX_CHAVE=+5548999999999
# PIX_BENEFICIARIO=Seu Nome
# PIX_CIDADE=Florianopolis

# Login com Google (opcional) — crie em console.cloud.google.com
# Redirect URI autorizada: https://SEU-DOMINIO/api/loja/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Separação de plataformas — deixe vazio em desenvolvimento (expõe tudo).
# Em produção, suba dois projetos na Vercel a partir do mesmo repositório:
#   ELO_APP=loja    → só a vitrine e o checkout
#   ELO_APP=gestao  → só a área interna
# ELO_APP=
