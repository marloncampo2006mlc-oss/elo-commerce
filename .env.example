# Servidor
PORT=3333
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=elo_commerce

# Sessão administrativa
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
ADMIN_PASSWORD=defina-uma-senha-forte

# Pix — sem estas variáveis, o checkout gera um código de DEMONSTRAÇÃO
# (formato válido, chave de exemplo, nenhum valor transferido).
# PIX_CHAVE=+5548999999999
# PIX_BENEFICIARIO=Seu Nome
# PIX_CIDADE=Florianopolis
